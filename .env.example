# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TOKEN_EXPIRY_HOURS=1
FRONTEND_PORT=443

# Container Images
PYTHON_IMAGE=python:3.14.5-alpine3.23
BUN_IMAGE=oven/bun:1.3.14-alpine
NGINX_IMAGE=nginx:1.31.0-alpine3.23-slim

# Seed Data
SEED_CURRENCIES='USD:US Dollar:$,EUR:Euro:\u20ac,GBP:British Pound:\u00a3,CAD:Canadian Dollar:C$,AUD:Australian Dollar:A$'
SEED_CATEGORIES='OFFICE:Office,ACCOUNTING:Accounting,TAXES:Taxes,HEALTH_INSURANCE:Health Insurance,OTHER:Other'
SEED_SUB_CATEGORIES='OFFICE:RENT:Rent,ACCOUNTING:ACCOUNTANT:Accountant,TAXES:TFE:TFE,HEALTH_INSURANCE:MEDICAL:Medical,HEALTH_INSURANCE:DENTAL:Dental'
SEED_BANKS='BANK_OF_AMERICA:Bank of America'
SEED_COMPANIES='OTHER:Other'

# Database
POSTGRES_HOST=finances_database
POSTGRES_PORT=5432
POSTGRES_DB=finances
POSTGRES_USER=finances
POSTGRES_PASSWORD=finances

# Django
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=UTC
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=change-me-to-a-random-string

# PTAX - BCB-Olinda-compatible OData URL
PTAX_CACHE_TTL_SECONDS=3600
PTAX_API_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
# {PTAX_API_URL}/CotacaoMoedaDia(moeda='EUR',dataCotacao='MM-DD-YYYY')

# Logging (pythonLogs)
LOG_LEVEL=INFO
LOG_TIMEZONE=UTC
LOG_APPNAME=finances
LOG_FILENAME=finances.log
LOG_DIRECTORY=/app/logs
LOG_DAYS_TO_KEEP=30
LOG_STREAM_HANDLER=True
LOG_SHOW_LOCATION=False
LOG_ROTATE_WHEN=midnight
